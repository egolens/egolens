{
  "kind": "egolens-adapter",
  "schemaVersion": 1,
  "engine": {
    "minimumVersion": "1.0.0",
    "requiredOperators": {
      "geometry.normalize_boxes2d": {
        "major": 1,
        "provider": "core"
      },
      "geometry.normalize_boxes3d": {
        "major": 1,
        "provider": "core"
      },
      "geometry.normalize_keypoints": {
        "major": 1,
        "provider": "core"
      },
      "geometry.range_image_to_cartesian": {
        "major": 1,
        "provider": "core"
      },
      "geometry.relative_poses": {
        "major": 1,
        "provider": "core"
      },
      "image.bind_camera_frame": {
        "major": 1,
        "provider": "core"
      },
      "labels.attach_by_point_index": {
        "major": 1,
        "provider": "core"
      },
      "labels.decode_camera_mask": {
        "major": 1,
        "provider": "core"
      },
      "parquet.columns": {
        "major": 1,
        "provider": "core"
      },
      "records.select": {
        "major": 1,
        "provider": "core"
      },
      "relations.composite_key_join": {
        "major": 1,
        "provider": "core"
      },
      "timeline.sort": {
        "major": 1,
        "provider": "core"
      },
      "tracks.derive_trajectories": {
        "major": 1,
        "provider": "core"
      }
    }
  },
  "identity": {
    "name": "Waymo Open Dataset",
    "description": "Waymo Open Dataset v2 component tables and range images."
  },
  "match": {
    "inventory": {
      "rootEntries": [
        {
          "path": "vehicle_pose",
          "required": true
        },
        {
          "path": "lidar_calibration",
          "required": false
        },
        {
          "path": "camera_calibration",
          "required": false
        },
        {
          "path": "lidar_box",
          "required": false
        },
        {
          "path": "lidar",
          "required": true
        },
        {
          "path": "camera_image",
          "required": true
        },
        {
          "path": "stats",
          "required": false
        },
        {
          "path": "lidar_pose",
          "required": false
        },
        {
          "path": "lidar_camera_projection",
          "required": false
        },
        {
          "path": "camera_box",
          "required": false
        },
        {
          "path": "projected_lidar_box",
          "required": false
        },
        {
          "path": "lidar_segmentation",
          "required": false
        },
        {
          "path": "camera_segmentation",
          "required": false
        },
        {
          "path": "lidar_hkp",
          "required": false
        },
        {
          "path": "camera_hkp",
          "required": false
        },
        {
          "path": "lidar_camera_synced_box",
          "required": false
        },
        {
          "path": "camera_to_lidar_box_association",
          "required": false
        }
      ]
    },
    "all": [
      {
        "kind": "path",
        "glob": "vehicle_pose",
        "minCount": 1
      },
      {
        "kind": "path",
        "glob": "lidar",
        "minCount": 1
      },
      {
        "kind": "path",
        "glob": "camera_image",
        "minCount": 1
      }
    ]
  },
  "sources": {
    "poseRows": {
      "reader": "parquet.columns",
      "files": {
        "glob": "vehicle_pose/**/*.parquet",
        "order": "numeric-path",
        "minCount": 1
      },
      "columns": [
        "key.frame_timestamp_micros",
        "[VehiclePoseComponent].world_from_vehicle.transform"
      ],
      "bindings": {
        "timestamp": "key.frame_timestamp_micros",
        "egoPose": "[VehiclePoseComponent].world_from_vehicle.transform"
      }
    },
    "lidarRows": {
      "reader": "parquet.columns",
      "files": {
        "glob": "lidar/**/*.parquet",
        "order": "numeric-path",
        "minCount": 1
      },
      "columns": [
        "key.frame_timestamp_micros",
        "key.laser_name",
        "[LiDARComponent].range_image_return1.shape",
        "[LiDARComponent].range_image_return1.values"
      ],
      "bindings": {
        "timestamp": "key.frame_timestamp_micros",
        "sensorId": "key.laser_name",
        "rangeImageShape": "[LiDARComponent].range_image_return1.shape",
        "rangeImageValues": "[LiDARComponent].range_image_return1.values"
      }
    },
    "lidarCalibrationRows": {
      "reader": "parquet.columns",
      "files": {
        "glob": "lidar_calibration/**/*.parquet",
        "order": "numeric-path"
      }
    },
    "cameraCalibrationRows": {
      "reader": "parquet.columns",
      "files": {
        "glob": "camera_calibration/**/*.parquet",
        "order": "numeric-path"
      }
    },
    "cameraImageRows": {
      "reader": "parquet.columns",
      "files": {
        "glob": "camera_image/**/*.parquet",
        "order": "numeric-path",
        "minCount": 1
      }
    },
    "box3dRows": {
      "reader": "parquet.columns",
      "files": {
        "glob": "lidar_box/**/*.parquet",
        "order": "numeric-path"
      }
    },
    "box2dRows": {
      "reader": "parquet.columns",
      "files": {
        "glob": "camera_box/**/*.parquet",
        "order": "numeric-path"
      }
    },
    "associationRows": {
      "reader": "parquet.columns",
      "files": {
        "glob": "camera_to_lidar_box_association/**/*.parquet",
        "order": "numeric-path"
      }
    },
    "lidarSegmentationRows": {
      "reader": "parquet.columns",
      "files": {
        "glob": "lidar_segmentation/**/*.parquet",
        "order": "numeric-path"
      }
    },
    "cameraSegmentationRows": {
      "reader": "parquet.columns",
      "files": {
        "glob": "camera_segmentation/**/*.parquet",
        "order": "numeric-path"
      }
    },
    "keypoints3dRows": {
      "reader": "parquet.columns",
      "files": {
        "glob": "lidar_hkp/**/*.parquet",
        "order": "numeric-path"
      }
    },
    "keypoints2dRows": {
      "reader": "parquet.columns",
      "files": {
        "glob": "camera_hkp/**/*.parquet",
        "order": "numeric-path"
      }
    },
    "statsRows": {
      "reader": "parquet.columns",
      "files": {
        "glob": "stats/**/*.parquet",
        "order": "numeric-path"
      }
    }
  },
