  "pipelines": {
    "timeline": {
      "nodes": [
        {
          "id": "sortTimeline",
          "op": "timeline.sort",
          "version": 1,
          "inputs": {
            "rows": "poseRows.rows"
          },
          "params": {
            "timestampField": "key.frame_timestamp_micros"
          }
        }
      ],
      "result": "sortTimeline.frames"
    },
    "egoPoses": {
      "nodes": [
        {
          "id": "normalizePoses",
          "op": "geometry.relative_poses",
          "version": 1,
          "inputs": {
            "rows": "poseRows.rows"
          },
          "params": {
            "matrixField": "[VehiclePoseComponent].world_from_vehicle.transform"
          }
        }
      ],
      "result": "normalizePoses.poses"
    },
    "pointClouds": {
      "nodes": [
        {
          "id": "decodeRangeImages",
          "op": "geometry.range_image_to_cartesian",
          "version": 1,
          "inputs": {
            "rangeImages": "lidarRows.rows",
            "calibration": "lidarCalibrationRows.rows",
            "poses": "poseRows.rows"
          },
          "params": {
            "returns": [
              1
            ],
            "outputFrame": "ego"
          }
        }
      ],
      "result": "decodeRangeImages.pointClouds"
    },
    "cameraImages": {
      "nodes": [
        {
          "id": "bindCameraImages",
          "op": "image.bind_camera_frame",
          "version": 1,
          "inputs": {
            "rows": "cameraImageRows.rows",
            "calibration": "cameraCalibrationRows.rows"
          },
          "params": {
            "encoding": "jpeg"
          }
        }
      ],
      "result": "bindCameraImages.images"
    },
    "boxes3d": {
      "nodes": [
        {
          "id": "normalizeBoxes3d",
          "op": "geometry.normalize_boxes3d",
          "version": 1,
          "inputs": {
            "rows": "box3dRows.rows"
          },
          "params": {
            "frameId": "ego"
          }
        }
      ],
      "result": "normalizeBoxes3d.boxes"
    },
    "boxes2d": {
      "nodes": [
        {
          "id": "normalizeBoxes2d",
          "op": "geometry.normalize_boxes2d",
          "version": 1,
          "inputs": {
            "rows": "box2dRows.rows"
          },
          "params": {
            "geometry": "center-size-pixels"
          }
        }
      ],
      "result": "normalizeBoxes2d.boxes"
    },
    "boxAssociations": {
      "nodes": [
        {
          "id": "associateBoxes",
          "op": "relations.composite_key_join",
          "version": 1,
          "inputs": {
            "boxes2d": "boxes2d.result",
            "boxes3d": "boxes3d.result",
            "associations": "associationRows.rows"
          },
          "params": {
            "relation": "camera-object-to-lidar-object"
          }
        }
      ],
      "result": "associateBoxes.relations"
    },
    "trajectories": {
      "nodes": [
        {
          "id": "deriveTrajectories",
          "op": "tracks.derive_trajectories",
          "version": 1,
          "inputs": {
            "boxes": "boxes3d.result"
          },
          "params": {
            "objectIdField": "objectId"
          }
        }
      ],
      "result": "deriveTrajectories.trajectories"
    },
    "lidarSegmentation": {
      "nodes": [
        {
          "id": "attachLidarLabels",
          "op": "labels.attach_by_point_index",
          "version": 1,
          "inputs": {
            "pointClouds": "pointClouds.result",
            "labels": "lidarSegmentationRows.rows"
          },
          "params": {
            "taxonomy": "waymo-lidar-semantics"
          }
        }
      ],
      "result": "attachLidarLabels.segmentation"
    },
    "cameraSegmentation": {
      "nodes": [
        {
          "id": "decodeCameraLabels",
          "op": "labels.decode_camera_mask",
          "version": 1,
          "inputs": {
            "rows": "cameraSegmentationRows.rows"
          },
          "params": {
            "encoding": "png-uint16",
            "taxonomy": "waymo-camera-semantics"
          }
        }
      ],
      "result": "decodeCameraLabels.segmentation"
    },
    "keypoints3d": {
      "nodes": [
        {
          "id": "normalizeKeypoints3d",
          "op": "geometry.normalize_keypoints",
          "version": 1,
          "inputs": {
            "rows": "keypoints3dRows.rows"
          },
          "params": {
            "dimensions": 3,
            "frameId": "ego"
          }
        }
      ],
      "result": "normalizeKeypoints3d.keypoints"
    },
    "keypoints2d": {
      "nodes": [
        {
          "id": "normalizeKeypoints2d",
          "op": "geometry.normalize_keypoints",
          "version": 1,
          "inputs": {
            "rows": "keypoints2dRows.rows"
          },
          "params": {
            "dimensions": 2,
            "coordinateSpace": "pixels"
          }
        }
      ],
      "result": "normalizeKeypoints2d.keypoints"
    },
    "segmentMetadata": {
      "nodes": [
        {
          "id": "selectSegmentMetadata",
          "op": "records.select",
          "version": 1,
          "inputs": {
            "rows": "statsRows.rows"
          },
          "params": {
            "fields": [
              "location",
              "time_of_day",
              "weather"
            ]
          }
        }
      ],
      "result": "selectSegmentMetadata.records"
    }
  },
  "outputs": {
    "timeline": "timeline.result",
    "egoPoses": "egoPoses.result",
    "pointClouds": "pointClouds.result",
    "cameraImages": "cameraImages.result",
    "boxes3d": "boxes3d.result",
    "boxes2d": "boxes2d.result",
    "boxAssociations": "boxAssociations.result",
    "trajectories": "trajectories.result",
    "lidarSegmentation": "lidarSegmentation.result",
    "cameraSegmentation": "cameraSegmentation.result",
    "keypoints3d": "keypoints3d.result",
    "keypoints2d": "keypoints2d.result",
    "segmentMetadata": "segmentMetadata.result"
  },
  "validation": {
    "sampleFrames": [
      "first",
      "middle",
      "last"
    ],
    "assertions": [
      {
        "kind": "timestamps-strictly-increasing",
        "output": "timeline"
      },
      {
        "kind": "finite-ratio",
        "output": "pointClouds",
        "minimum": 0.9999
      },
      {
        "kind": "box-dimensions-positive",
        "output": "boxes3d"
      },
      {
        "kind": "projection-in-frame-ratio",
        "output": "cameraImages",
        "minimum": 0.05
      }
    ],
    "humanReview": [
      "orientation",
      "handedness",
      "scale",
      "box-alignment",
      "camera-projection",
      "temporal-synchronization",
      "segmentation-alignment",
      "keypoint-alignment"
    ]
  },
