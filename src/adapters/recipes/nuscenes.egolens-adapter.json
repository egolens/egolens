          "version": 1,
          "inputs": {
            "records": "lidarRecords.records",
            "sampleData": "sampleData.rows",
            "calibration": "calibrations.rows"
          },
          "params": {
            "mode": "token"
          }
        }
      ],
      "result": "joinLidarFrames.pointClouds"
    },
    "radarPointClouds": {
      "nodes": [
        {
          "id": "joinRadarFrames",
          "op": "timeline.join",
          "version": 1,
          "inputs": {
            "records": "radarRecords.records",
            "sampleData": "sampleData.rows",
            "calibration": "calibrations.rows"
          },
          "params": {
            "mode": "token"
          }
        }
      ],
      "result": "joinRadarFrames.pointClouds"
    },
    "cameraImages": {
