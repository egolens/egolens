          "inputs": {
            "samples": "samples.rows"
          },
          "params": {
            "timestampField": "timestamp"
          }
        }
      ],
      "result": "sortTimeline.frames"
    },
    "egoPoses": {
      "nodes": [
        {
          "id": "joinEgoPoses",
          "op": "relations.token_join",
          "version": 1,
          "inputs": {
            "sampleData": "sampleData.rows",
            "poses": "egoPoses.rows"
          },
          "params": {
            "leftKey": "ego_pose_token",
            "rightKey": "token"
          }
        }
      ],
      "result": "joinEgoPoses.rows"
    },
    "pointClouds": {
      "nodes": [
        {
          "id": "joinLidarFrames",
