{
  "kind": "egolens-adapter",
  "schemaVersion": 1,
  "engine": {
    "minimumVersion": "1.0.0",
    "requiredOperators": {
      "archive.npz_array": {
        "major": 1,
        "provider": "core"
      },
      "binary.interleaved_records": {
        "major": 1,
        "provider": "core"
      },
      "binary.pcd_records": {
        "major": 1,
        "provider": "core"
      },
      "geometry.normalize_boxes2d": {
        "major": 1,
        "provider": "core"
      },
      "geometry.normalize_boxes3d": {
        "major": 1,
        "provider": "core"
      },
      "image.bind_camera_frame": {
        "major": 1,
        "provider": "core"
      },
      "image.encoded_bytes": {
        "major": 1,
        "provider": "core"
      },
      "json.records": {
        "major": 1,
        "provider": "core"
      },
      "labels.attach_by_point_index": {
        "major": 1,
        "provider": "core"
      },
      "records.select": {
        "major": 1,
        "provider": "core"
      },
      "relations.token_join": {
        "major": 1,
        "provider": "core"
      },
      "timeline.join": {
        "major": 1,
        "provider": "core"
      },
      "timeline.sort": {
        "major": 1,
        "provider": "core"
      },
      "tracks.derive_trajectories": {
        "major": 1,
        "provider": "core"
      }
    }
  },
  "identity": {
    "name": "nuScenes",
    "description": "nuScenes JSON tables with interleaved LiDAR, PCD radar, and camera streams."
  },
  "match": {
    "inventory": {
      "rootEntries": [
        {
          "path": "samples",
          "required": true
        },
        {
          "path": "sweeps",
          "required": false
        },
        {
          "path": "maps",
          "required": false
        },
        {
          "path": "lidarseg",
          "required": false
        },
        {
          "path": "panoptic",
          "required": false
        },
        {
          "path": "v1.0-mini",
          "required": false
        },
        {
          "path": "v1.0-trainval",
          "required": false
        },
        {
          "path": "v1.0-test",
          "required": false
        },
        {
          "path": "LICENSE",
          "required": false
        }
      ]
    },
    "versionRoot": {
      "candidates": [
        "v1.0-mini",
        "v1.0-trainval",
        "v1.0-test"
      ],
      "requiredFiles": [
        "scene.json",
        "sample.json",
        "sample_data.json",
        "ego_pose.json",
        "calibrated_sensor.json",
        "sensor.json"
      ]
    },
    "all": [
      {
        "kind": "path",
        "glob": "samples",
        "minCount": 1
      }
    ]
  },
  "sources": {
    "samples": {
      "reader": "json.records",
      "files": {
        "exact": "{versionRoot}/sample.json"
      }
    },
    "sampleData": {
      "reader": "json.records",
      "files": {
        "exact": "{versionRoot}/sample_data.json"
      }
    },
    "egoPoses": {
      "reader": "json.records",
      "files": {
        "exact": "{versionRoot}/ego_pose.json"
      }
    },
    "calibrations": {
      "reader": "json.records",
      "files": {
        "exact": "{versionRoot}/calibrated_sensor.json"
      }
    },
    "sensors": {
      "reader": "json.records",
      "files": {
        "exact": "{versionRoot}/sensor.json"
      }
    },
    "annotations": {
      "reader": "json.records",
      "files": {
        "exact": "{versionRoot}/sample_annotation.json"
      }
    },
    "instances": {
      "reader": "json.records",
      "files": {
        "exact": "{versionRoot}/instance.json"
      }
    },
    "categories": {
      "reader": "json.records",
      "files": {
        "exact": "{versionRoot}/category.json"
      }
    },
    "lidarRecords": {
      "reader": "binary.interleaved_records",
      "files": {
        "glob": "samples/LIDAR_TOP/*.bin",
        "order": "lexical-path"
      },
      "params": {
        "strideBytes": 20,
        "littleEndian": true,
        "fields": [
          {
            "name": "x",
            "type": "float32",
            "offsetBytes": 0
          },
          {
            "name": "y",
            "type": "float32",
            "offsetBytes": 4
          },
          {
            "name": "z",
            "type": "float32",
            "offsetBytes": 8
          },
          {
            "name": "intensity",
            "type": "float32",
            "offsetBytes": 12
          }
        ]
      }
    },
    "radarRecords": {
      "reader": "binary.pcd_records",
      "files": {
        "glob": "samples/RADAR_*/*.pcd",
        "order": "lexical-path"
      },
      "params": {
        "data": "binary",
        "trailingPadding": "zero",
        "maxTrailingBytes": 4096,
        "fields": [
          "x",
          "y",
          "z",
          "vx",
          "vy",
          "vx_comp",
          "vy_comp"
        ]
      }
    },
    "cameraBytes": {
      "reader": "image.encoded_bytes",
      "files": {
        "glob": "samples/CAM_*/*.jpg",
        "order": "lexical-path"
      },
      "params": {
        "mimeType": "image/jpeg"
      }
    },
    "lidarLabels": {
      "reader": "binary.interleaved_records",
      "files": {
        "glob": "lidarseg/{versionRoot}/*.bin",
        "order": "lexical-path"
      },
      "params": {
        "strideBytes": 1,
        "littleEndian": true,
        "fields": [
          {
            "name": "semantic",
            "type": "uint8",
            "offsetBytes": 0
          }
        ]
      }
    },
    "panopticLabels": {
      "reader": "archive.npz_array",
      "files": {
        "glob": "panoptic/{versionRoot}/*.npz",
        "order": "lexical-path"
      },
      "params": {
        "arrayName": "data"
      }
    }
  },
