{
  "kind": "egolens-adapter",
  "schemaVersion": 1,
  "engine": {
    "minimumVersion": "1.0.0",
    "requiredOperators": {
      "feather.columns": {
        "major": 1,
        "provider": "core"
      },
      "geometry.normalize_boxes2d": {
        "major": 1,
        "provider": "core"
      },
      "geometry.normalize_boxes3d": {
        "major": 1,
        "provider": "core"
      },
      "image.bind_camera_frame": {
        "major": 1,
        "provider": "core"
      },
      "image.encoded_bytes": {
        "major": 1,
        "provider": "core"
      },
      "records.select": {
        "major": 1,
        "provider": "core"
      },
      "timeline.join": {
        "major": 1,
        "provider": "core"
      },
      "timeline.sort": {
        "major": 1,
        "provider": "core"
      },
      "tracks.derive_trajectories": {
        "major": 1,
        "provider": "core"
      }
    }
  },
  "identity": {
    "name": "Argoverse 2",
    "description": "Argoverse 2 Sensor Dataset Feather tables and ring-camera streams."
  },
  "match": {
    "inventory": {
      "rootEntries": [
        {
          "path": "sensors",
          "required": true
        },
        {
          "path": "calibration",
          "required": true
        },
        {
          "path": "map",
          "required": false
        },
        {
          "path": "annotations.feather",
          "required": false
        },
        {
          "path": "city_SE3_egovehicle.feather",
          "required": false
        }
      ]
    },
    "all": [
      {
        "kind": "path",
        "glob": "sensors",
        "minCount": 1
      },
      {
        "kind": "path",
        "glob": "calibration",
        "minCount": 1
      }
    ]
  },
  "sources": {
    "lidarFrames": {
      "reader": "feather.columns",
      "files": {
        "glob": "sensors/lidar/*.feather",
        "order": "numeric-path",
        "minCount": 1
      },
      "columns": [
        "x",
        "y",
        "z",
        "intensity"
      ]
    },
    "cameraFrames": {
      "reader": "image.encoded_bytes",
      "files": {
        "glob": "sensors/cameras/**/*.jpg",
        "order": "numeric-path"
      },
      "params": {
        "mimeType": "image/jpeg"
      }
    },
    "extrinsics": {
      "reader": "feather.columns",
      "files": {
        "exact": "calibration/egovehicle_SE3_sensor.feather"
      }
    },
    "intrinsics": {
      "reader": "feather.columns",
      "files": {
        "exact": "calibration/intrinsics.feather"
      }
    },
    "annotations": {
      "reader": "feather.columns",
      "files": {
        "exact": "annotations.feather"
      },
      "columns": [
        "timestamp_ns",
        "category",
        "track_uuid",
        "qw",
        "qx",
        "qy",
        "qz",
        "tx_m",
        "ty_m",
        "tz_m",
        "length_m",
        "width_m",
        "height_m"
      ]
    },
    "poses": {
      "reader": "feather.columns",
      "files": {
        "exact": "city_SE3_egovehicle.feather"
      },
      "columns": [
        "timestamp_ns",
        "qw",
        "qx",
        "qy",
        "qz",
        "tx_m",
        "ty_m",
        "tz_m"
      ]
    }
  },
  "scene": {
    "formatId": "argoverse2",
    "timeline": {
      "timestampUnit": "ns",
      "nominalFrameRate": 10
    },
    "coordinateFrames": [
      {
        "id": "ego",
        "convention": {
          "x": "forward",
          "y": "left",
          "z": "up",
          "handedness": "right",
          "lengthUnit": "m"
        }
      },
      {
        "id": "lidar-frame",
        "parent": "ego",
        "convention": {
          "x": "forward",
          "y": "left",
          "z": "up",
          "handedness": "right",
          "lengthUnit": "m"
