    "pointAttributes": [
      {
        "id": "x",
        "storage": "float32",
        "unit": "m"
      },
      {
        "id": "y",
        "storage": "float32",
        "unit": "m"
      },
      {
        "id": "z",
        "storage": "float32",
        "unit": "m"
      },
      {
        "id": "intensity",
        "storage": "float32",
        "range": [
          0,
          255
        ]
      }
    ],
    "pointLayout": {
      "interleavedAttributes": [
        "x",
        "y",
        "z",
        "intensity"
      ],
      "colorModes": [
        "distance",
        "intensity",
        "camera"
      ]
    }
  },
  "pipelines": {
    "timeline": {
      "nodes": [
        {
          "id": "sortTimeline",
          "op": "timeline.sort",
          "version": 1,
          "inputs": {
            "lidar": "lidarFrames.rows"
          },
          "params": {
            "timestampFrom": "numeric-path",
            "timestampUnit": "ns"
          }
        }
      ],
      "result": "sortTimeline.frames"
    },
    "egoPoses": {
      "nodes": [
        {
          "id": "joinEgoPoses",
          "op": "timeline.join",
          "version": 1,
          "inputs": {
            "timeline": "timeline.result",
            "poses": "poses.rows"
          },
          "params": {
            "timestampField": "timestamp_ns",
            "mode": "nearest"
          }
        }
      ],
      "result": "joinEgoPoses.poses"
    },
    "pointClouds": {
      "nodes": [
        {
          "id": "selectPointClouds",
          "op": "records.select",
          "version": 1,
          "inputs": {
            "rows": "lidarFrames.rows"
          },
          "params": {
            "fields": [
              "x",
              "y",
              "z",
              "intensity"
            ],
            "frameId": "ego"
          }
        }
      ],
      "result": "selectPointClouds.pointClouds"
    },
    "cameraImages": {
      "nodes": [
        {
          "id": "bindCameraImages",
          "op": "image.bind_camera_frame",
          "version": 1,
          "inputs": {
            "bytes": "cameraFrames.bytes",
            "intrinsics": "intrinsics.rows",
            "extrinsics": "extrinsics.rows"
          },
          "params": {
            "timestampFrom": "numeric-path"
          }
        }
      ],
      "result": "bindCameraImages.images"
    },
    "boxes3d": {
      "nodes": [
        {
          "id": "normalizeBoxes3d",
          "op": "geometry.normalize_boxes3d",
          "version": 1,
          "inputs": {
            "annotations": "annotations.rows"
          },
          "params": {
            "quaternionOrder": "wxyz",
            "frameId": "ego"
          }
        }
      ],
      "result": "normalizeBoxes3d.boxes"
    },
    "boxes2d": {
      "nodes": [
        {
          "id": "normalizeBoxes2d",
          "op": "geometry.normalize_boxes2d",
          "version": 1,
          "inputs": {
            "boxes3d": "boxes3d.result",
            "cameraImages": "cameraImages.result",
            "intrinsics": "intrinsics.rows",
            "extrinsics": "extrinsics.rows"
          },
          "params": {
            "source": "projected-box3d",
            "clipToImage": true
          }
        }
      ],
      "result": "normalizeBoxes2d.boxes"
    },
    "trajectories": {
      "nodes": [
        {
          "id": "deriveTrajectories",
          "op": "tracks.derive_trajectories",
          "version": 1,
          "inputs": {
            "boxes": "boxes3d.result"
          },
          "params": {
            "objectIdField": "track_uuid"
          }
        }
      ],
      "result": "deriveTrajectories.trajectories"
    },
    "segmentMetadata": {
      "nodes": [
        {
          "id": "selectSegmentMetadata",
          "op": "records.select",
          "version": 1,
          "inputs": {
            "poses": "poses.rows"
          },
          "params": {
            "fields": [
              "timestamp_ns"
            ]
          }
        }
      ],
      "result": "selectSegmentMetadata.records"
    }
  },
  "outputs": {
    "timeline": "timeline.result",
    "egoPoses": "egoPoses.result",
    "pointClouds": "pointClouds.result",
    "cameraImages": "cameraImages.result",
    "boxes3d": "boxes3d.result",
    "boxes2d": "boxes2d.result",
    "trajectories": "trajectories.result",
    "segmentMetadata": "segmentMetadata.result"
  },
  "validation": {
    "sampleFrames": [
      "first",
      "middle",
      "last"
    ],
    "assertions": [
      {
        "kind": "timestamps-strictly-increasing",
        "output": "timeline"
      },
      {
        "kind": "finite-ratio",
        "output": "pointClouds",
        "minimum": 0.9999
      },
      {
        "kind": "box-dimensions-positive",
        "output": "boxes3d"
      },
      {
        "kind": "projection-in-frame-ratio",
        "output": "cameraImages",
        "minimum": 0.05
      }
    ],
    "humanReview": [
      "orientation",
      "handedness",
      "scale",
      "ego-motion",
      "box-alignment",
      "camera-projection",
      "temporal-synchronization"
    ]
  },
  "provenance": {
    "author": "registry",
    "createdAt": "2026-08-29T00:00:00Z",
    "summary": "Bundled Phase 2 declarative manifest migration."
  }
}
