{
  "kind": "egolens-adapter",
  "schemaVersion": 1,
  "engine": {
    "minimumVersion": "1.0.0",
    "requiredOperators": {
      "text.table": {
        "major": 1,
        "provider": "core"
      },
      "binary.interleaved_records": {
        "major": 1,
        "provider": "core"
      },
      "image.encoded_bytes": {
        "major": 1,
        "provider": "core"
      },
      "xml.records": {
        "major": 1,
        "provider": "core"
      },
      "records.unpivot": {
        "major": 1,
        "provider": "core"
      },
      "records.explode": {
        "major": 1,
        "provider": "core"
      },
      "records.derive": {
        "major": 1,
        "provider": "core"
      },
      "records.select": {
        "major": 1,
        "provider": "core"
      },
      "relations.token_join": {
        "major": 1,
        "provider": "core"
      },
      "timeline.sort": {
        "major": 1,
        "provider": "core"
      },
      "timeline.join": {
        "major": 1,
        "provider": "core"
      },
      "image.bind_camera_frame": {
        "major": 1,
        "provider": "core"
      },
      "geometry.geodetic_poses": {
        "major": 1,
        "provider": "core"
      },
      "geometry.normalize_boxes3d": {
        "major": 1,
        "provider": "core"
      }
    }
  },
  "identity": {
    "name": "KITTI Raw synced and rectified drive",
    "description": "KITTI Raw 2011_09_26_drive_0001_sync with four rectified cameras, Velodyne, OXTS, and tracklets."
  },
  "match": {
    "inventory": {
      "rootEntries": [
        {
          "path": "2011_09_26_drive_0001_sync",
          "required": true
        },
        {
          "path": "calib_cam_to_cam.txt",
          "required": true
        },
        {
          "path": "calib_velo_to_cam.txt",
          "required": true
        },
        {
          "path": "calib_imu_to_velo.txt",
          "required": true
        }
      ]
    },
    "all": [
      {
        "kind": "path",
        "glob": "2011_09_26_drive_0001_sync/image_00/data/*.png",
        "minCount": 1
      },
      {
        "kind": "path",
        "glob": "2011_09_26_drive_0001_sync/image_01/data/*.png",
        "minCount": 1
      },
      {
        "kind": "path",
        "glob": "2011_09_26_drive_0001_sync/image_02/data/*.png",
        "minCount": 1
      },
      {
        "kind": "path",
        "glob": "2011_09_26_drive_0001_sync/image_03/data/*.png",
        "minCount": 1
      },
      {
        "kind": "path",
        "glob": "2011_09_26_drive_0001_sync/velodyne_points/data/*.bin",
        "minCount": 1
      },
      {
        "kind": "size",
        "glob": "2011_09_26_drive_0001_sync/velodyne_points/data/*.bin",
        "minimum": 16,
        "divisibleBy": 16
      },
      {
        "kind": "path",
        "glob": "2011_09_26_drive_0001_sync/oxts/data/*.txt",
        "minCount": 1
      },
      {
        "kind": "path",
        "glob": "2011_09_26_drive_0001_sync/tracklet_labels.xml",
        "minCount": 1
      }
    ]
  },
  "sources": {
    "master_timestamps": {
      "reader": "text.table",
      "files": {
        "exact": "2011_09_26_drive_0001_sync/oxts/timestamps.txt"
      },
      "params": {
        "layout": "lines",
        "field": "stamp",
        "indexField": "frame",
        "pathField": "source_path",
        "maxRows": 108
      }
    },
    "lidar_timestamps": {
      "reader": "text.table",
      "files": {
        "exact": "2011_09_26_drive_0001_sync/velodyne_points/timestamps.txt"
      },
      "params": {
        "layout": "lines",
        "field": "stamp",
        "indexField": "frame",
        "pathField": "source_path",
        "maxRows": 108
      }
    },
    "oxts_rows": {
      "reader": "text.table",
      "files": {
        "glob": "2011_09_26_drive_0001_sync/oxts/data/*.txt",
        "order": "numeric-path",
        "minCount": 108
      },
      "params": {
        "layout": "delimited",
        "delimiter": " ",
        "header": false,
        "numeric": true,
        "pathField": "path",
        "maxRows": 108,
        "maxColumns": 30,
        "columns": [
          "lat",
          "lon",
          "alt",
          "roll",
          "pitch",
          "yaw",
          "vn",
          "ve",
          "vf",
          "vl",
          "vu",
          "ax",
          "ay",
          "az",
          "af",
          "al",
          "au",
          "wx",
          "wy",
          "wz",
          "wf",
          "wl",
          "wu",
          "pos_accuracy",
          "vel_accuracy",
          "navstat",
          "numsats",
          "posmode",
          "velmode",
          "orimode"
        ]
      }
    },
    "velodyne_points": {
      "reader": "binary.interleaved_records",
      "files": {
        "glob": "2011_09_26_drive_0001_sync/velodyne_points/data/*.bin",
        "order": "numeric-path",
        "minCount": 108
      },
      "params": {
        "strideBytes": 16,
        "littleEndian": true,
        "fields": [
          {
            "name": "x",
            "type": "float32",
            "offsetBytes": 0
          },
          {
            "name": "y",
            "type": "float32",
            "offsetBytes": 4
          },
          {
            "name": "z",
            "type": "float32",
            "offsetBytes": 8
          },
          {
            "name": "reflectance",
            "type": "float32",
            "offsetBytes": 12
          }
        ],
        "maxRecords": 160000,
        "maxOutputBytes": 67108864
      }
    },
    "camera_pngs": {
      "reader": "image.encoded_bytes",
      "files": {
        "glob": "2011_09_26_drive_0001_sync/image_0?/data/*.png",
        "order": "numeric-path",
        "minCount": 432
      },
      "params": {
        "mimeType": "image/png"
      }
    },
    "camera_calibration": {
      "reader": "text.table",
      "files": {
        "exact": "calib_cam_to_cam.txt"
      },
      "params": {
        "layout": "key-values",
        "keySeparator": ":",
        "numeric": true,
        "pathField": "path",
        "maxRows": 64,
        "maxColumns": 64
      }
    },
    "velo_calibration": {
      "reader": "text.table",
      "files": {
        "exact": "calib_velo_to_cam.txt"
      },
      "params": {
        "layout": "key-values",
        "keySeparator": ":",
        "numeric": true,
        "pathField": "path",
        "maxRows": 8,
        "maxColumns": 16
      }
    },
    "tracklets": {
      "reader": "xml.records",
      "files": {
        "exact": "2011_09_26_drive_0001_sync/tracklet_labels.xml"
      },
      "params": {
        "recordPath": "boost_serialization/tracklets/item",
        "pathField": "source_path",
        "numeric": true,
        "maxRecords": 512,
        "maxDepth": 64
      }
    },
    "camera_timestamps_00": {
      "reader": "text.table",
      "files": {
        "exact": "2011_09_26_drive_0001_sync/image_00/timestamps.txt"
      },
      "params": {
        "layout": "lines",
        "field": "stamp",
        "indexField": "frame",
        "pathField": "source_path",
        "maxRows": 108
      }
    },
    "camera_timestamps_01": {
      "reader": "text.table",
      "files": {
        "exact": "2011_09_26_drive_0001_sync/image_01/timestamps.txt"
      },
      "params": {
        "layout": "lines",
        "field": "stamp",
        "indexField": "frame",
        "pathField": "source_path",
        "maxRows": 108
      }
    },
    "camera_timestamps_02": {
      "reader": "text.table",
      "files": {
        "exact": "2011_09_26_drive_0001_sync/image_02/timestamps.txt"
      },
      "params": {
        "layout": "lines",
        "field": "stamp",
        "indexField": "frame",
        "pathField": "source_path",
        "maxRows": 108
      }
    },
    "camera_timestamps_03": {
      "reader": "text.table",
      "files": {
        "exact": "2011_09_26_drive_0001_sync/image_03/timestamps.txt"
      },
      "params": {
        "layout": "lines",
        "field": "stamp",
        "indexField": "frame",
        "pathField": "source_path",
        "maxRows": 108
      }
    }
  },
