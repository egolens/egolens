  "pipelines": {
    "timeline_pipeline": {
      "nodes": [
        {
          "id": "sort_timeline",
          "op": "timeline.sort",
          "version": 1,
          "inputs": {
            "rows": "master_timestamps.rows"
          },
          "params": {
            "timestampField": "stamp",
            "timestampUnit": "us",
            "keyField": "frame",
            "groupField": "source_path"
          }
        }
      ],
      "result": "sort_timeline.frames"
    },
    "ego_pose_pipeline": {
      "nodes": [
        {
          "id": "oxts_key",
          "op": "records.derive",
          "version": 1,
          "inputs": {
            "rows": "oxts_rows.rows"
          },
          "params": {
            "derive": [
              {
                "field": "frame_key",
                "from": "path",
                "pattern": "^.*/0*([0-9]+)\\.txt$",
                "replacement": "$1",
                "required": true
              }
            ]
          }
        },
        {
          "id": "stamp_key",
          "op": "records.derive",
          "version": 1,
          "inputs": {
            "rows": "master_timestamps.rows"
          },
          "params": {
            "derive": [
              {
                "field": "frame_key",
                "from": "frame",
                "pattern": "^([0-9]+)$",
                "replacement": "$1",
                "required": true
              }
            ]
          }
        },
        {
          "id": "oxts_with_stamp",
          "op": "relations.token_join",
          "version": 1,
          "inputs": {
            "left": "oxts_key.rows",
            "right": "stamp_key.rows"
          },
          "params": {
            "leftKey": "frame_key",
            "rightKey": "frame_key",
            "join": "inner",
            "rightFields": {
              "stamp": "stamp"
            }
          }
        },
        {
          "id": "geodetic_poses",
          "op": "geometry.geodetic_poses",
          "version": 1,
          "inputs": {
            "rows": "oxts_with_stamp.rows"
          },
          "params": {
            "timestampField": "stamp",
            "latitudeField": "lat",
            "longitudeField": "lon",
            "altitudeField": "alt",
            "rollField": "roll",
            "pitchField": "pitch",
            "yawField": "yaw",
            "angleUnit": "radians"
          }
        }
      ],
      "result": "geodetic_poses.poses"
    },
    "point_cloud_pipeline": {
      "nodes": [
        {
          "id": "lidar_base_fields",
          "op": "records.derive",
          "version": 1,
          "inputs": {
            "rows": "master_timestamps.rows"
          },
          "params": {
            "derive": [
              {
                "field": "stem",
                "from": "frame",
                "pattern": "^([0-9]+)$",
                "replacement": "$1",
                "required": true,
                "pad": 10
              },
              {
                "field": "frame_key",
                "from": "frame",
                "pattern": "^([0-9]+)$",
                "replacement": "$1",
                "required": true
              },
              {
                "field": "sensor_id",
                "from": "source_path",
                "pattern": "^.*$",
                "replacement": "velodyne_points",
                "required": true
              }
            ]
          }
        },
        {
          "id": "lidar_sample_key",
          "op": "records.derive",
          "version": 1,
          "inputs": {
            "rows": "lidar_base_fields.rows"
          },
          "params": {
            "derive": [
              {
                "field": "path",
                "from": "stem",
                "pattern": "^([0-9]{10})$",
                "replacement": "2011_09_26_drive_0001_sync/velodyne_points/data/$1.bin",
                "required": true
              }
            ]
          }
        },
        {
          "id": "tag_velo_calibration",
          "op": "records.derive",
          "version": 1,
          "inputs": {
            "rows": "velo_calibration.rows"
          },
          "params": {
            "derive": [
              {
                "field": "sensor_id",
                "from": "path",
                "pattern": "^.*$",
                "replacement": "velodyne_points",
                "required": true
              }
            ]
          }
        },
        {
          "id": "bind_lidar",
          "op": "timeline.join",
          "version": 1,
          "inputs": {
            "records": "velodyne_points.records",
            "sampleData": "lidar_sample_key.rows",
            "calibration": "tag_velo_calibration.rows",
            "sensors": "tag_velo_calibration.rows"
          },
          "params": {
            "mode": "token",
            "pathField": "path",
            "frameKeyField": "frame",
            "recordKeyField": "frame",
            "timestampField": "stamp",
            "recordCalibrationKeyField": "sensor_id",
            "calibrationKeyField": "sensor_id",
            "calibrationSensorKeyField": "sensor_id",
            "sensorKeyField": "sensor_id",
            "sensorIdField": "sensor_id",
            "quaternionField": "R",
            "translationField": "T",
            "rotationForm": "identity",
            "outputFrame": "ego"
          }
        }
      ],
      "result": "bind_lidar.pointClouds"
    },
