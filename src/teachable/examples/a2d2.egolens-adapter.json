{
  "kind": "egolens-adapter",
  "schemaVersion": 1,
  "engine": {
    "minimumVersion": "1.0.0",
    "requiredOperators": {
      "json.records": {
        "major": 1,
        "provider": "core"
      },
      "records.derive": {
        "major": 1,
        "provider": "core"
      },
      "archive.npz_records": {
        "major": 1,
        "provider": "core"
      },
      "image.encoded_bytes": {
        "major": 1,
        "provider": "core"
      },
      "records.select": {
        "major": 1,
        "provider": "core"
      },
      "timeline.sort": {
        "major": 1,
        "provider": "core"
      },
      "timeline.join": {
        "major": 1,
        "provider": "core"
      },
      "image.bind_camera_frame": {
        "major": 1,
        "provider": "core"
      },
      "relations.token_join": {
        "major": 1,
        "provider": "core"
      }
    }
  },
  "identity": {
    "name": "A2D2 sensor-fusion preview",
    "description": "One A2D2 scene with six synchronized camera-view image streams and six camera-view lidar point streams."
  },
  "match": {
    "inventory": {
      "rootEntries": [
        {
          "path": "20180810_150607",
          "required": true
        },
        {
          "path": "cams_lidars.json",
          "required": true
        }
      ]
    },
    "all": [
      {
        "kind": "path",
        "glob": "20180810_150607/camera/*/*.json",
        "minCount": 240,
        "maxCount": 240
      },
      {
        "kind": "path",
        "glob": "20180810_150607/camera/*/*.png",
        "minCount": 240,
        "maxCount": 240
      },
      {
        "kind": "path",
        "glob": "20180810_150607/lidar/*/*.npz",
        "minCount": 240,
        "maxCount": 240
      },
      {
        "kind": "path",
        "glob": "cams_lidars.json",
        "minCount": 1,
        "maxCount": 1
      }
    ]
  },
  "sources": {
    "sidecars": {
      "reader": "json.records",
      "files": {
        "glob": "20180810_150607/camera/*/*.json",
        "order": "numeric-path",
        "minCount": 240,
        "maxCount": 240
      },
      "params": {
        "layout": "file-row",
        "pathField": "path"
      }
    },
    "viewCalibration": {
      "reader": "json.records",
      "files": {
        "exact": "cams_lidars.json",
        "order": "none",
        "minCount": 1,
        "maxCount": 1
      },
      "params": {
        "layout": "object-rows",
        "rootPath": "cameras",
        "keyField": "name",
        "flatten": true
      }
    },
    "lidarRecords": {
      "reader": "archive.npz_records",
      "files": {
        "glob": "20180810_150607/lidar/*/*.npz",
        "order": "numeric-path",
        "minCount": 240,
        "maxCount": 240
      },
      "params": {
        "arrays": [
          {
            "name": "pcloud_points",
            "fields": [
              "x",
              "y",
              "z"
            ]
          }
        ],
        "maxEntries": 32,
        "maxExpandedBytes": 67108864,
        "maxCompressionRatio": 10000,
        "maxElements": 10000000,
        "maxRank": 2
      }
    },
    "imageBytes": {
      "reader": "image.encoded_bytes",
      "files": {
        "glob": "20180810_150607/camera/*/*.png",
        "order": "numeric-path",
        "minCount": 240,
        "maxCount": 240
      },
      "params": {
        "mimeType": "image/png"
      }
    },
    "sensorSidecars": {
      "reader": "json.records",
      "files": {
        "glob": "20180810_150607/camera/*/*_000000083.json",
        "order": "lexical-path",
        "minCount": 6,
        "maxCount": 6
      },
      "params": {
        "layout": "file-row",
        "pathField": "path"
      }
    }
  },
