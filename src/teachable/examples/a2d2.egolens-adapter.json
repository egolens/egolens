            "derive": [
              {
                "field": "imagePath",
                "from": "path",
                "pattern": "\\.json$",
                "replacement": ".png",
                "required": true
              },
              {
                "field": "lidarPath",
                "from": "path",
                "pattern": "^([^/]+)/camera/([^/]+)/(.+)_camera_(.+)\\.json$",
                "replacement": "$1/lidar/$2/$3_lidar_$4.npz",
                "required": true
              },
              {
                "field": "frameKey",
                "from": "path",
                "pattern": "^.*_([0-9]{9})\\.json$",
                "replacement": "$1",
                "required": true
              },
              {
                "field": "sceneId",
                "from": "path",
                "pattern": "^([^/]+)/.*$",
                "replacement": "$1",
                "required": true
              },
              {
                "field": "cameraSensor",
                "from": "cam_name",
                "pattern": "^(.*)$",
                "replacement": "camera_$1",
                "required": true
              },
              {
                "field": "lidarSensor",
                "from": "cam_name",
                "pattern": "^(.*)$",
                "replacement": "lidar_$1",
                "required": true
              },
              {
                "field": "modality",
                "from": "cam_name",
                "pattern": "^.*$",
                "replacement": "camera",
                "required": true
              },
              {
                "field": "syncKey",
                "from": "path",
                "pattern": "^(.*)$",
                "replacement": "$1",
                "required": true
