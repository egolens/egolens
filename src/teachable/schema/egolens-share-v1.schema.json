{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egolens.org/schema/egolens-share-v1.schema.json",
  "title": "EgoLens Share Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "recipe", "view", "presentation"],
  "properties": {
    "schema": { "const": "egolens-share-v1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootUrl", "catalogUrl", "catalogHash", "sourceManifestHash"],
      "properties": {
        "rootUrl": { "$ref": "#/$defs/url" },
        "catalogUrl": { "$ref": "#/$defs/url" },
        "catalogHash": { "$ref": "#/$defs/hash" },
        "sourceManifestHash": { "$ref": "#/$defs/hash" }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "recipeHash"],
      "properties": {
        "url": { "$ref": "#/$defs/url" },
        "recipeHash": { "$ref": "#/$defs/hash" }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sceneId", "frameIndex"],
      "properties": {
        "sceneId": { "$ref": "#/$defs/id" },
        "frameIndex": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "t0": { "$ref": "#/$defs/int64" },
        "t1": { "$ref": "#/$defs/int64" }
      },
      "dependentRequired": {
        "t0": ["t1"],
        "t1": ["t0"]
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cameraStrip", "coordinateMode", "visibleSensorIds", "activeCameraId",
        "colormap", "boxMode", "trailLength", "pointSize", "pointOpacity",
        "overlays", "playbackSpeed", "followCamera", "cameraPose", "theme", "accent"
      ],
      "properties": {
        "cameraStrip": { "type": "boolean" },
        "coordinateMode": { "enum": ["ego", "world"] },
        "visibleSensorIds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sensorId" }
        },
        "activeCameraId": {
          "oneOf": [
            { "$ref": "#/$defs/sensorId" },
            { "type": "null" }
          ]
        },
        "colormap": { "enum": ["distance", "intensity", "range", "elongation", "segment", "panoptic", "camera"] },
        "boxMode": { "enum": ["off", "box", "model"] },
        "trailLength": { "type": "integer", "minimum": 0, "maximum": 50 },
        "pointSize": { "type": "number", "minimum": 0.02, "maximum": 0.3 },
        "pointOpacity": { "type": "number", "minimum": 0.1, "maximum": 1 },
        "overlays": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lidarProjection", "keypoints3d", "keypoints2d", "cameraSegmentation"],
          "properties": {
            "lidarProjection": { "type": "boolean" },
            "keypoints3d": { "type": "boolean" },
            "keypoints2d": { "type": "boolean" },
            "cameraSegmentation": { "type": "boolean" }
          }
        },
        "playbackSpeed": { "type": "number", "minimum": 0.5, "maximum": 4 },
        "followCamera": { "type": "boolean" },
        "cameraPose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "target", "azimuth", "distance"],
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "target": { "$ref": "#/$defs/vector3" },
            "azimuth": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
            "distance": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 }
          }
        },
        "theme": { "enum": ["light", "dark"] },
        "accent": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9A-F]{6}$" },
            { "type": "null" }
          ]
        }
      }
    }
  },
  "$defs": {
    "url": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sensorId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^,\\u0000-\\u001F\\u007F]+$" },
    "int64": { "type": "string", "pattern": "^-?(0|[1-9][0-9]{0,18})$" },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "minimum": -1000000, "maximum": 1000000 }
    }
  }
}
