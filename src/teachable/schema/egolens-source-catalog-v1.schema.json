{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egolens.org/schema/egolens-source-catalog-v1.schema.json",
  "title": "EgoLens Source Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entries", "catalogHash"],
  "properties": {
    "schema": { "const": "egolens-source-catalog-v1" },
    "entries": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "mediaType": { "type": "string", "minLength": 1, "maxLength": 255 },
          "chunks": {
            "type": "object",
            "additionalProperties": false,
            "required": ["size", "digests"],
            "properties": {
              "size": { "type": "integer", "minimum": 65536, "maximum": 67108864 },
              "digests": {
                "type": "array",
                "maxItems": 1048576,
                "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    },
    "catalogHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
