{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egolens.org/schema/egolens-phase10-baseline-freeze-v1.schema.json",
  "title": "EgoLens Phase 10 three-dataset baseline freeze v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "candidateCommit", "requirementsHash", "frozenAt", "heldOutState",
    "datasets", "gates", "allPassed", "freezeHash"
  ],
  "properties": {
    "schema": { "const": "egolens-phase10-baseline-freeze-v1" },
    "candidateCommit": { "$ref": "#/$defs/commit" },
    "requirementsHash": { "$ref": "#/$defs/hash" },
    "frozenAt": { "type": "string", "format": "date-time" },
    "heldOutState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semanticInspectionStarted", "contentBlindManifestFreezeStarted", "sourceMounted"],
      "properties": {
        "semanticInspectionStarted": { "const": false },
        "contentBlindManifestFreezeStarted": { "const": false },
        "sourceMounted": { "const": false }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/datasetEvidence" }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regression", "productionBuild", "authorBuild", "productionBoundary",
        "authorBoundary", "adapterAmnesia", "oracleReceipts", "performanceLifecycle",
        "negativeCases", "evidenceHarness"
      ],
      "properties": {
        "regression": { "$ref": "#/$defs/gate" },
        "productionBuild": { "$ref": "#/$defs/gate" },
        "authorBuild": { "$ref": "#/$defs/gate" },
        "productionBoundary": { "$ref": "#/$defs/gate" },
        "authorBoundary": { "$ref": "#/$defs/gate" },
        "adapterAmnesia": { "$ref": "#/$defs/gate" },
        "oracleReceipts": { "$ref": "#/$defs/gate" },
        "performanceLifecycle": { "$ref": "#/$defs/gate" },
        "negativeCases": {
          "type": "array",
          "minItems": 13,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed", "evidenceHash"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "passed": { "const": true },
              "evidenceHash": { "$ref": "#/$defs/hash" }
            }
          }
        },
        "evidenceHarness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "evidenceHash", "schemaHashes", "freshProcessSelfTest"],
          "properties": {
            "passed": { "const": true },
            "evidenceHash": { "$ref": "#/$defs/hash" },
            "schemaHashes": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
            "freshProcessSelfTest": { "const": true }
          }
        }
      }
    },
    "allPassed": { "const": true },
    "freezeHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "nullableHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "evidenceHash"],
      "properties": {
        "passed": { "const": true },
        "evidenceHash": { "$ref": "#/$defs/hash" }
      }
    },
    "modeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "noAgent", "emptyProfile", "sourceManifestHash", "catalogHash",
        "shareDescriptorHash", "recipeHash", "formatFingerprint", "operatorSetFingerprint",
        "capabilityHash", "structuralHash", "numericHash", "perceptualHash",
        "presentationHash", "performanceHash", "lifecycleHash", "browserRunHash",
        "paused", "passed"
      ],
      "properties": {
        "mode": { "enum": ["local", "remote", "share"] },
        "noAgent": { "const": true },
        "emptyProfile": { "type": "boolean" },
        "sourceManifestHash": { "$ref": "#/$defs/hash" },
        "catalogHash": { "$ref": "#/$defs/nullableHash" },
        "shareDescriptorHash": { "$ref": "#/$defs/nullableHash" },
        "recipeHash": { "$ref": "#/$defs/hash" },
        "formatFingerprint": { "$ref": "#/$defs/hash" },
        "operatorSetFingerprint": { "$ref": "#/$defs/hash" },
        "capabilityHash": { "$ref": "#/$defs/hash" },
        "structuralHash": { "$ref": "#/$defs/hash" },
        "numericHash": { "$ref": "#/$defs/hash" },
        "perceptualHash": { "$ref": "#/$defs/hash" },
        "presentationHash": { "$ref": "#/$defs/hash" },
        "performanceHash": { "$ref": "#/$defs/hash" },
        "lifecycleHash": { "$ref": "#/$defs/hash" },
        "browserRunHash": { "$ref": "#/$defs/hash" },
        "paused": { "const": true },
        "passed": { "const": true }
      }
    },
    "datasetEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetId", "caseId", "candidateCommit", "sourceCaseManifestHash",
        "sourceManifestHash", "recipeHash", "formatFingerprint", "operatorSetFingerprint",
        "capabilities", "local", "remote", "share", "parityPassed", "evidenceHash"
      ],
      "properties": {
        "datasetId": { "enum": ["waymo", "nuscenes", "argoverse2"] },
        "caseId": { "$ref": "#/$defs/id" },
        "candidateCommit": { "$ref": "#/$defs/commit" },
        "sourceCaseManifestHash": { "$ref": "#/$defs/hash" },
        "sourceManifestHash": { "$ref": "#/$defs/hash" },
        "recipeHash": { "$ref": "#/$defs/hash" },
        "formatFingerprint": { "$ref": "#/$defs/hash" },
        "operatorSetFingerprint": { "$ref": "#/$defs/hash" },
        "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "local": { "$ref": "#/$defs/modeEvidence" },
        "remote": { "$ref": "#/$defs/modeEvidence" },
        "share": { "$ref": "#/$defs/modeEvidence" },
        "parityPassed": { "const": true },
        "evidenceHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
