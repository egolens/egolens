{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egolens.org/schema/egolens-phase10-build-boundary-report-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "candidateCommit", "sourceTreeHash", "cleanHeadVerified",
    "detachedCheckoutVerified", "ignoredInputsExcluded", "sanitizedEnvironmentVerified",
    "dependencyInstall", "dependencyManifestHash", "reviewedBuildInputManifestHash", "verifierBinding", "sandbox",
    "production", "author", "passed", "reportHash"
  ],
  "properties": {
    "schema": { "const": "egolens-phase10-build-boundary-report-v1" },
    "candidateCommit": { "$ref": "#/$defs/commit" },
    "sourceTreeHash": { "$ref": "#/$defs/hash" },
    "cleanHeadVerified": { "const": true },
    "detachedCheckoutVerified": { "const": true },
    "ignoredInputsExcluded": { "const": true },
    "sanitizedEnvironmentVerified": { "const": true },
    "dependencyInstall": { "const": "reviewed-verifier-node-modules-closure" },
    "dependencyManifestHash": { "$ref": "#/$defs/hash" },
    "reviewedBuildInputManifestHash": { "$ref": "#/$defs/hash" },
    "verifierBinding": { "$ref": "#/$defs/verifierBinding" },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform", "sandboxProfileHash", "reviewedDriverHash", "nodeRuntimeHash",
        "dependencyEntryHash", "productionSourceStageHash", "authorSourceStageHash",
        "authorSourceGraphHash", "candidatePreSourceTreeHash", "candidatePostSourceTreeHash",
        "verifierPreSourceTreeHash", "verifierPostSourceTreeHash",
        "candidateScriptsInvoked", "gitHistoryAbsent",
        "authorAllowlistedStage", "authorPinnedGraphPolicy", "reviewedExecutableConfigsOnly",
        "detachedChildCleanupVerified", "residualProcessAuditPassed", "dependencyClosureUnchanged", "networkDenied",
        "protectedRootsDenied", "trackedSourceWriteDenied", "processGroupCleanup",
        "candidateRepositoryUnchanged", "verifierCheckoutUnchanged", "sourceUnchanged", "passed"
      ],
      "properties": {
        "platform": { "const": "macos-seatbelt-deny-default" },
        "sandboxProfileHash": { "$ref": "#/$defs/hash" },
        "reviewedDriverHash": { "$ref": "#/$defs/hash" },
        "nodeRuntimeHash": { "$ref": "#/$defs/hash" },
        "dependencyEntryHash": { "$ref": "#/$defs/hash" },
        "productionSourceStageHash": { "$ref": "#/$defs/hash" },
        "authorSourceStageHash": { "$ref": "#/$defs/hash" },
        "authorSourceGraphHash": { "$ref": "#/$defs/hash" },
        "candidatePreSourceTreeHash": { "$ref": "#/$defs/hash" },
        "candidatePostSourceTreeHash": { "$ref": "#/$defs/hash" },
        "verifierPreSourceTreeHash": { "$ref": "#/$defs/hash" },
        "verifierPostSourceTreeHash": { "$ref": "#/$defs/hash" },
        "candidateScriptsInvoked": { "const": false },
        "gitHistoryAbsent": { "const": true },
        "authorAllowlistedStage": { "const": true },
        "authorPinnedGraphPolicy": { "const": true },
        "reviewedExecutableConfigsOnly": { "const": true },
        "detachedChildCleanupVerified": { "const": true },
        "residualProcessAuditPassed": { "const": true },
        "dependencyClosureUnchanged": { "const": true },
        "networkDenied": { "const": true },
        "protectedRootsDenied": { "const": true },
        "trackedSourceWriteDenied": { "const": true },
        "processGroupCleanup": { "const": true },
        "candidateRepositoryUnchanged": { "const": true },
        "verifierCheckoutUnchanged": { "const": true },
        "sourceUnchanged": { "const": true },
        "passed": { "const": true }
      }
    },
    "production": { "$ref": "#/$defs/build" },
    "author": { "$ref": "#/$defs/build" },
    "passed": { "const": true },
    "reportHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "verifierBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifierId", "verifierToolCommit", "verifierSourceTreeHash", "verifierClosureHash",
        "verifierClosureVersion", "verifierDependencyClosureHash", "verifierNodeRuntimeHash",
        "verifierTrustManifestHash", "verifierTrustReviewId",
        "verifierRequirement"
      ],
      "properties": {
        "verifierId": { "const": "egolens-phase10-p7-reviewed-verifier-v1" },
        "verifierToolCommit": { "$ref": "#/$defs/commit" },
        "verifierSourceTreeHash": { "$ref": "#/$defs/hash" },
        "verifierClosureHash": { "$ref": "#/$defs/hash" },
        "verifierClosureVersion": { "const": 2 },
        "verifierDependencyClosureHash": { "$ref": "#/$defs/hash" },
        "verifierNodeRuntimeHash": { "$ref": "#/$defs/hash" },
        "verifierTrustManifestHash": { "$ref": "#/$defs/hash" },
        "verifierTrustReviewId": { "$ref": "#/$defs/id" },
        "verifierRequirement": { "const": "external-reviewed-tool-checkout-required" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fileCount", "totalBytes", "inventoryHash", "phase9ContentHash", "sourceMaps", "deniedMarkers", "exactCommitEmbedded", "passed"],
      "properties": {
        "name": { "enum": ["production", "author"] },
        "fileCount": { "type": "integer", "minimum": 1 },
        "totalBytes": { "type": "integer", "minimum": 1 },
        "inventoryHash": { "$ref": "#/$defs/hash" },
        "phase9ContentHash": { "$ref": "#/$defs/hash" },
        "sourceMaps": { "const": 0 },
        "deniedMarkers": { "const": 0 },
        "exactCommitEmbedded": { "const": true },
        "passed": { "const": true }
      }
    }
  }
}
