{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egolens.org/schema/egolens-phase10-evidence-harness-gate-report-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidateCommit", "tests", "schemaHashes", "freshProcessSelfTest", "tapHash", "passed", "reportHash"],
  "properties": {
    "schema": { "const": "egolens-phase10-evidence-harness-gate-report-v1" },
    "candidateCommit": { "$ref": "#/$defs/commit" },
    "tests": { "type": "integer", "minimum": 6 },
    "schemaHashes": { "type": "array", "minItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
    "freshProcessSelfTest": { "const": true },
    "tapHash": { "$ref": "#/$defs/hash" },
    "passed": { "const": true },
    "reportHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
